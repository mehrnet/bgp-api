[Unit]
Description=MehrNet BGP PostgreSQL dataset sync
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/bgp-api/postgres.env
WorkingDirectory=/srv/bgp-api
ExecStart=/usr/bin/flock -n /var/lock/bgp-api-postgres-sync.lock /srv/bgp-api/scripts/sync-postgres.sh
