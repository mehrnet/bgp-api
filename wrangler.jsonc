{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bgp-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-26",
  "routes": [
    {
      "pattern": "bgp-api.mehrnet.com",
      "custom_domain": true
    }
  ],
  "vars": {
    "BUN_API_ORIGIN": "https://replace-with-your-bun-origin.example.com"
  },
  "ratelimits": [
    {
      "name": "RL_IP_LOOKUP",
      "namespace_id": "1101",
      "simple": { "limit": 120, "period": 60 }
    }
  ]
}
