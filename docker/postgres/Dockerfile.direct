FROM postgres:15.13-bookworm@sha256:d1f651d3a24650cd68a4e7fcf4eef7bd772c2ec965c3563f36b91c1fecddac76

ENV PGDATA=/var/lib/postgresql/mehrnet-data

RUN apt-get update \
    && apt-get install -y --no-install-recommends zstd \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p "$PGDATA" \
    && chown postgres:postgres "$PGDATA"

COPY pgdata.tar.zst /usr/local/share/mehrnet-pgdata.tar.zst
COPY snapshot-entrypoint.sh /usr/local/bin/mehrnet-snapshot-entrypoint
RUN chmod 0755 /usr/local/bin/mehrnet-snapshot-entrypoint

ENTRYPOINT ["mehrnet-snapshot-entrypoint"]
CMD ["postgres"]
