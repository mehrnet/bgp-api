[Unit]
Description=MehrNet BGP API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bgpapi
Group=bgpapi
EnvironmentFile=/etc/bgp-api/bgp-api.env
ExecStart=/usr/local/bin/bgp-api
Restart=always
RestartSec=5
LogRateLimitIntervalSec=30s
LogRateLimitBurst=200
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/var/lib/bgp-api

[Install]
WantedBy=multi-user.target
